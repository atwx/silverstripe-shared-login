{
    "name": "atwx/silverstripe-shared-login",
    "description": "One login for Silverstripe apps on several subdomains: shared session, central login host, external sign-in (Google & co.) for existing members only.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Andy Adiwidjaja",
            "email": "mail@adiwidjaja.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6"
    },
    "suggest": {
        "bigfork/silverstripe-oauth-login": "Sign in with external providers",
        "league/oauth2-google": "Sign in with Google"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\SharedLogin\\": "src/",
            "Atwx\\SharedLogin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
